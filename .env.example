# Koneksi database PostgreSQL (bisa pakai Vercel Postgres, Neon, atau Supabase - semua gratis untuk skala kecil)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Kredensial login admin (ganti dengan yang aman)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-dengan-password-kuat"

# Secret untuk menandatangani session admin (isi string acak panjang, minimal 32 karakter)
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# Nama & deskripsi instansi (opsional, tampil di header/footer)
NEXT_PUBLIC_SITE_NAME="Knowledge Base BDK Makassar"
